NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Local: mongodb://127.0.0.1:27017/zappy  |  Atlas: mongodb+srv://<user>:<pass>@<cluster>/zappy
MONGODB_URI=mongodb://127.0.0.1:27017/zappy

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list, or * to allow all (dev only)
CORS_ORIGINS=*

# Used by `npm run seed:admin`
ADMIN_NAME=Zappy Admin
ADMIN_EMAIL=admin@zappy.dev
ADMIN_PASSWORD=ChangeMe123!
